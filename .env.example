# Database
# --------------------------------------------------
# Local (docker-compose.yml incluido)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Neon / Vercel Postgres / Supabase / Railway / etc.
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# Better Auth
# --------------------------------------------------
# Genera uno seguro:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL base de la app (Next.js la usa para cookies, redirects, etc.)
# Dev local
BETTER_AUTH_URL="http://localhost:3000"

# Prod (Vercel la inyecta automáticamente como VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL)
# BETTER_AUTH_URL="https://tu-dominio.vercel.app"

# Opcional: v0 preview iframe (solo si desarrollás dentro de v0.dev)
# V0_RUNTIME_URL="https://xxxxx.v0.dev"

# Optional: Analytics / Monitoring
# --------------------------------------------------
# VERCEL_ANALYTICS_ID=""